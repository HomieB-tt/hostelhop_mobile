# Copy to `.env` (gitignored) and fill in. Not bundled into the app; pass it at build/run time:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env

SUPABASE_URL=
SUPABASE_ANON_KEY=

FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/

# Used for Places autocomplete (university/campus search). Restrict by app in Google Cloud.
GOOGLE_MAPS_API_KEY=
